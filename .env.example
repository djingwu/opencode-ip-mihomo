# 对外访问设置
# Windows / 仅本机访问建议 127.0.0.1
# 需要让其它 Docker 容器访问时可改为 docker0 网关，例如 172.17.0.1
BIND_IP=127.0.0.1
GATEWAY_PORT=24513

# mihomo Controller 密钥；生产环境建议填写随机字符串
MIHOMO_SECRET=

# 可选镜像覆盖
PROXY_IMAGE=jiuwangka/opencode-ip-mihomo-proxy:latest
ROTATOR_IMAGE=jiuwangka/opencode-ip-mihomo-rotator:latest

# 可选调优
MIHOMO_MAX_LATENCY=300
WARP_ROTATION_INTERVAL=300
